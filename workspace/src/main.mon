// Digimon Evolution System
// Main game logic for dotmon

Start
{
    // Define base stats
    Baby nivel = 15;
    Rook experiencia = 5000;
    Pup forca = 27.49;
    Moji nome = "Agumon";
    Moji evolucao = "Greymon";
    Bit prontoParaCombate = true;

    Xros evoluirNivel (nivel) {
        Evo (nivel <= 15) {
            nivel = nivel + 10;
            Show("Digimon evolui para o nível: ", nivel);
            Send nivel;
        }
        FailEvo {
            Show("Seu digimon já está muito forte, não precisa de evolução" );
            Send nivel;
        }
    }

    // Check evolution conditions
    Evo (nivel > 15) {
        Show("Mega evolucao disponivel!");
        Show(evolucao);
        Show("Pronto para lutar: ", prontoParaCombate);
    }
    AltEvo (nivel == 10) {
        Show("Evolucao padrao");
        Show(nome);
    }
    FailEvo {
        Show("Nivel insuficiente");
        prontoParaCombate = false;
        Show("Pronto para lutar:", prontoParaCombate );
    }

    // Battle calculation
    Pup dano = experiencia * nivel * forca;
    Show(dano);

    // Display results
    Show("Batalha concluida!");
}
Finish
