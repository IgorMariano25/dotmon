// Battle System Module
// Handles combat logic between Digimons

Start
{
    // Attacker stats
    Moji atacante = "WarGreymon";
    Rook ataque = 850;
    Baby velocidade = 120;

    // Defender stats
    Moji defensor = "MetalGarurumon";
    Baby defesa = 780;
    Baby hp = 1200;

    // Calculate damage
    Baby dano = ataque - defesa;

    Evo (dano > 0) {
        hp = hp - dano;
        Show("Dano causado!");
        Show(atacante, "ofereceu dano de:", dano);
        Show("Velocidade do ataque foi de:", velocidade);
        Show(defensor, "sofreu dano de:", dano);
    }
    FailEvo {
        Show("Ataque bloqueado!");
    }

    Show(hp);
}
Finish
